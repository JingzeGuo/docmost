#!/bin/bash
set -euo pipefail

# We assume that the data volume is attached as /dev/sdf. This is the default for Terraform when using an EBS volume with a single instance.
DATA_DEVICE=/dev/sdf

until [ -b "$DATA_DEVICE" ]; do
  sleep 5
done

echo "Data volume found at $DATA_DEVICE"

dnf update -y
dnf install -y docker xfsprogs

systemctl enable docker
systemctl start docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL \
  https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose

chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

docker compose version

if ! blkid "$DATA_DEVICE"; then # if there is already a filesystem on the device, don't format it
  mkfs.xfs "$DATA_DEVICE" # format the device with XFS filesystem
fi

mkdir -p /data # create the mount directory
mount "$DATA_DEVICE" /data # mount the device to the directory

DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE") # get the UUID of the device
echo "UUID=$DATA_UUID /data xfs defaults,nofail 0 2" >> /etc/fstab # add the mount to /etc/fstab for automatic mounting on boot

mkdir -p /data/docmost /data/postgres /data/redis

mkdir -p /opt/docmost
